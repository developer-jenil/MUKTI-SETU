# MUKTI-SETU environment — copy to .env and fill in
[TEMPLATE]

# Runtime mode: CLOUD | LOCAL | HYBRID (default HYBRID)
MODE=HYBRID

# Backend URL used by the web app
MUKTI_API_URL=http://localhost:8000

# Optional PostgreSQL — without it the app runs on mock persistence
DATABASE_URL=postgresql://mukti:mukti@postgres:5432/mukti

# Groq LLM — without a key the conservative offline fallback is used
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192
LLM_PROVIDER=groq
LLM_MIN_CONFIDENCE=0.90

# OCR: mock | easyocr (easyocr requires requirements-ocr.txt)
OCR_PROVIDER=mock

# Identity and audit signing. CLOUD mode forces AUTH_REQUIRED=true.
AUTH_REQUIRED=false
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
AUDIT_SIGNING_SECRET=replace-with-a-separate-long-random-secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CLAMAV_SOCKET=
